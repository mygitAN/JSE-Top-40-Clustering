+   "cell_type": "markdown",
+   "id": "jse-study-19a",
+   "metadata": {},
+   "source": [
+    "### Cluster histories across the three dates\n",
+    "\n",
+    "Each row is an instrument observed at all three dates. Cluster labels at each later date are aligned to the previous date with the Hungarian maximum-Jaccard assignment on continuing members (deterministic solver). A cluster with no positive overlap gets a fresh label that is never reused. Colours and numbers are aligned descriptive labels, not sectors or permanent identities. The full code is in the next cell; it reads only the saved `assignments.csv` of each model and writes nothing to the run folder."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "jse-study-19b",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "# Cluster histories: Hungarian maximum-Jaccard alignment of cluster labels across dates,\n",
+    "# then one row per instrument observed at every date. Self-contained: no project helpers.\n",
+    "import numpy as np\n",
+    "import pandas as pd\n",
+    "import matplotlib.pyplot as plt\n",
+    "from matplotlib.colors import ListedColormap, BoundaryNorm\n",
+    "from scipy.optimize import linear_sum_assignment\n",
+    "\n",
+    "HISTORY_DATES = list(study.config[\"dates\"])\n",
+    "\n",
+    "\n",
+    "def align_to_previous(previous, current, next_fresh_id):\n",
+    "    \"\"\"Relabel `current` clusters to the `previous` aligned labels by maximum Jaccard.\n",
+    "\n",
+    "    Both inputs are Series indexed by ticker. Overlap is measured on continuing members only.\n",
+    "    A current cluster with no positive-overlap match gets a fresh ID that was never used before.\n",
+    "    \"\"\"\n",
+    "    common = previous.index.intersection(current.index)\n",
+    "    old_labels, new_labels = sorted(previous.unique()), sorted(current.unique())\n",
+    "    old_sets = {c: set(common[previous.loc[common] == c]) for c in old_labels}\n",
+    "    new_sets = {c: set(common[current.loc[common] == c]) for c in new_labels}\n",
+    "    intersections = np.array([[len(old_sets[a] & new_sets[b]) for b in new_labels] for a in old_labels])\n",
+    "    unions = np.array([[len(old_sets[a] | new_sets[b]) for b in new_labels] for a in old_labels])\n",
+    "    jaccard = np.divide(intersections, unions, out=np.zeros(intersections.shape), where=unions > 0)\n",
+    "    rows, cols = linear_sum_assignment(-jaccard)  # deterministic Hungarian solver, maximise Jaccard\n",
+    "    mapping = {new_labels[c]: old_labels[r] for r, c in zip(rows, cols) if intersections[r, c] > 0}\n",
+    "    for label in new_labels:  # zero-overlap matches are rejected -> fresh, never-reused ID\n",
+    "        if label not in mapping:\n",
+    "            mapping[label] = next_fresh_id\n",
+    "            next_fresh_id += 1\n",
+    "    return current.map(mapping), next_fresh_id\n",
+    "\n",
+    "\n",
+    "def cluster_histories(assignments, dates):\n",
+    "    \"\"\"Return a ticker x date table of aligned labels for instruments present at all dates.\"\"\"\n",
+    "    raw = {d: assignments[assignments.decision_date == d].set_index(\"ticker\")[\"cluster\"].astype(int)\n",
+    "           for d in dates}\n",
+    "    aligned = {dates[0]: raw[dates[0]]}\n",
+    "    next_fresh_id = int(raw[dates[0]].max()) + 1\n",
+    "    for before, after in zip(dates, dates[1:]):\n",
+    "        aligned[after], next_fresh_id = align_to_previous(aligned[before], raw[after], next_fresh_id)\n",
+    "    table = pd.DataFrame(aligned)\n",
+    "    observed = table.dropna().astype(int)\n",
+    "    observed[\"status\"] = np.where(observed[dates].nunique(axis=1) == 1, \"stable all dates\", \"shifted at least once\")\n",
+    "    # Same row order as the Paper Experiments figure: by label at each date, then ticker.\n",
+    "    return observed.reset_index(names=\"ticker\").sort_values(dates + [\"ticker\"]).reset_index(drop=True)\n",
+    "\n",
+    "\n",
+    "def plot_cluster_histories(observed, dates, title):\n",
+    "    labels = sorted(set(observed[dates].to_numpy().ravel()))\n",
+    "    index = {label: i for i, label in enumerate(labels)}\n",
+    "    colours = plt.get_cmap(\"tab20\")(np.linspace(0, 1, len(labels)))\n",
+    "    grid = np.array([[index[v] for v in row] for row in observed[dates].to_numpy()])\n",
+    "    fig, ax = plt.subplots(figsize=(8, max(5, 0.28 * len(observed) + 1.5)))\n",
+    "    ax.imshow(grid, cmap=ListedColormap(colours), norm=BoundaryNorm(np.arange(len(labels) + 1) - 0.5, len(labels)),\n",
+    "              aspect=\"auto\", interpolation=\"nearest\")\n",
+    "    for i, row in enumerate(observed[dates].to_numpy()):\n",
+    "        for j, label in enumerate(row):\n",
+    "            luminance = colours[index[label]][:3] @ np.array([0.2126, 0.7152, 0.0722])\n",
+    "            ax.text(j, i, str(label), ha=\"center\", va=\"center\", fontsize=7,\n",
+    "                    color=\"white\" if luminance < 0.45 else \"black\")\n",
+    "    ax.set_xticks(range(len(dates)), dates)\n",
+    "    ax.set_yticks(range(len(observed)), observed.ticker, fontsize=8)\n",
+    "    ax.set_title(f\"{title}\\nCluster histories: {len(observed)} instruments observed at all dates\\n\"\n",
+    "                 \"Numbers are aligned descriptive labels, not sectors\", fontsize=11)\n",
+    "    fig.tight_layout()\n",
+    "    plt.show()\n",
+    "\n",
+    "\n",
+    "for model_name, folder in study.model_folders.items():\n",
+    "    assignments = pd.read_csv(folder / \"assignments.csv\")\n",
+    "    histories = cluster_histories(assignments, HISTORY_DATES)\n",
+    "    plot_cluster_histories(histories, HISTORY_DATES, model_name)\n",
+    "    print(f\"{model_name}: {int((histories.status == 'stable all dates').sum())} stable, \"\n",
+    "          f\"{int((histories.status == 'shifted at least once').sum())} shifted of {len(histories)}\")\n",
+    "    display(histories[histories.status == \"shifted at least once\"])"
    ]
   },
