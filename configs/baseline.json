  "surrogate": {"n_estimators": 150, "max_depth": 2, "learning_rate": 0.05, "subsample": 1, "colsample_bytree": 1, "n_jobs": 1, "objective": "multi:softprob", "eval_metric": "mlogloss"},
  "seed": 42,
  "stability_runs": 5,
  "sensitivity_k": [2,3,4,5,6,7,8,9,10],
  "silhouette_metric": "euclidean",
  "davies_bouldin_metric": "euclidean embedding centroids",
  "selection_policy": "fixed descriptive comparisons; no score-based promotion"
}
